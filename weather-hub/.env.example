# Comma-separated list of origins (scheme + host + port) allowed to make
# cross-origin requests, e.g. the URL the dashboard is actually loaded from
# in the browser. Leave unset to allow all origins (CORS disabled).
CORS_ALLOWED_ORIGINS=http://home-hub:8200