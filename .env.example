# Copy this file to .env (in this same directory) and adjust values as needed.
# docker-compose automatically loads a .env file next to compose.yaml.

# Prod / external database: uncomment to stop compose.override.yaml (the local
# Postgres container) from being auto-merged in, and point DB_HOST below at
# your external Postgres instance instead. See the "Full stack via Docker"
# section in CLAUDE.md.
#COMPOSE_FILE=compose.yaml

DB_HOST=db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=weatherhub

# Host ports - change these if already in use on your machine
POSTGRES_PORT=5434
WEATHER_HUB_PORT=8100
WEATHER_DASHBOARD_PORT=8200

# weather-dashboard build-time config (baked into the static bundle when the
# image is built, not read at container runtime - see the compose file comment
# on the weather-dashboard service). Full base URL (scheme + host + optional
# port, no trailing slash) that the BROWSER can reach weather-hub at - not a
# compose service name, and independent of WEATHER_HUB_PORT above (that's just
# the local port mapping). If unset, defaults to http://localhost:8100.
#
# LAN example:    WEATHER_DASHBOARD_API_URL=http://home-hub:8100
# Domain example: WEATHER_DASHBOARD_API_URL=https://weatherhubapi.steve-lab.uk
WEATHER_DASHBOARD_API_URL=http://home-hub:8100

# Comma-separated list of origins (scheme + host + port) allowed to call
# weather-hub from a browser - normally just the URL the dashboard is loaded
# from, i.e. http://<host>:<WEATHER_DASHBOARD_PORT> (or the https domain the
# dashboard is proxied to, e.g. https://weatherhub.steve-lab.uk).
CORS_ALLOWED_ORIGINS=http://home-hub:8200
