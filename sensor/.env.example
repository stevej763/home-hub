# Scheme, hostname/IP, and port of the weather-hub instance this sensor reports
# to. All are optional - if unset, the sensor falls back to http://home-hub:3001.
#
# To point at a resolved domain over https instead of a LAN host:port, set
# SENSOR_SERVER_SCHEME=https and leave SENSOR_SERVER_PORT empty (below) so the
# URL omits the port and uses the scheme's default (443 for https).
SENSOR_SERVER_SCHEME=https
SENSOR_SERVER_IP=weatherhubapi.steve-lab.uk
SENSOR_SERVER_PORT=443
