# Full base URL (scheme + host + optional port, no trailing slash) of the
# weather-hub instance this sensor reports to. Optional - if unset, the sensor
# falls back to http://home-hub:3001.
#
# LAN example:   SENSOR_SERVER_URL=http://home-hub:3001
# Domain example: SENSOR_SERVER_URL=https://weatherhubapi.steve-lab.uk
SENSOR_SERVER_URL=https://weatherhubapi.steve-lab.uk
