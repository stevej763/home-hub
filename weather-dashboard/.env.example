# Scheme, hostname, and port of the weather-hub instance this dashboard calls.
# VITE_API_SCHEME is optional (defaults to http). Leave VITE_API_PORT empty to
# omit the port from the URL (e.g. for a resolved https domain on 443).
VITE_API_SCHEME = http
VITE_API_SERVER = home-hub
VITE_API_PORT = 3001
